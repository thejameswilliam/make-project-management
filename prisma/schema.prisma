generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  password  String
  name      String?
  role      UserRole  @default(STAFF)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  projects     Project[]
  stage2Scores Stage2Score[]
}

enum UserRole {
  ADMIN
  LEADERSHIP
  STAFF
}

model Project {
  id           String        @id @default(cuid())
  name         String
  currentStage Int           @default(1)
  status       ProjectStatus @default(ACTIVE)
  proposedById String
  proposedBy   User          @relation(fields: [proposedById], references: [id])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  stage1       Stage1Data?
  stage2       Stage2Data?
  stage3       Stage3Data?
  stage4       Stage4Data?
  stage5       Stage5Data?
}

enum ProjectStatus {
  ACTIVE
  PARKED
  KILLED
  ARCHIVED
}

model Stage1Data {
  id                     String      @id @default(cuid())
  projectId              String      @unique
  project                Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  problemStatement       String      @db.Text
  missionAlignment       Boolean     @default(false)
  nicheFit               Boolean     @default(false)
  tenYearAlignment       Boolean     @default(false)
  coreValueName          String
  noCoreValueViolated    Boolean     @default(false)
  oneYearPlanGoal        String?     @db.Text
  goalId                 String?
  goal                   AnnualGoal? @relation(fields: [goalId], references: [id])
  isStrategicException   Boolean     @default(false)
  strategicExceptionNote String?     @db.Text
  noDistractionRisk      Boolean     @default(false)
  completedAt            DateTime?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
}

model Stage2Score {
  id                  String     @id @default(cuid())
  stage2Id            String
  stage2              Stage2Data @relation(fields: [stage2Id], references: [id], onDelete: Cascade)
  userId              String
  user                User       @relation(fields: [userId], references: [id])
  scoreStratAlignment Float
  scoreImpact         Float
  scoreFeasibility    Float
  scoreCompetency     Float
  scoreRisk           Float
  scoreTimeToImpact   Float
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  @@unique([stage2Id, userId])
}

model Stage2Data {
  id                  String        @id @default(cuid())
  projectId           String        @unique
  project             Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scores              Stage2Score[]
  description         String        @db.Text
  expectedOutcome     String        @db.Text
  targetAudience      String        @db.Text
  oneTimeCost         String
  ongoingCost         String
  revenueOrSavings    String
  fundingSource       FundingSource
  staffHoursLaunch    String
  staffHoursSustain   String
  noStaffDisruption   Boolean       @default(false)
  newStaffingNote     String?       @db.Text
  spaceRequired       String
  equipmentRequired   String
  noResourceConflict  Boolean       @default(false)
  estimatedLaunchDate String
  isWithin90Days      Boolean       @default(false)
  quarterlyMilestones String?       @db.Text
  scoreStratAlignment Float
  scoreImpact         Float
  scoreFeasibility    Float
  scoreCompetency     Float
  scoreRisk           Float
  scoreTimeToImpact   Float
  scoreTotal          Float
  completedAt         DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
}

enum FundingSource {
  EXISTING_BUDGET
  REALLOCATION
  GRANT
  FUNDRAISING
  DONOR_DIRECTED
  NOT_IDENTIFIED
}

model Stage3Data {
  id                    String    @id @default(cuid())
  projectId             String    @unique
  project               Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ownerName             String
  ownerGetsIt           Boolean   @default(false)
  ownerWantsIt          Boolean   @default(false)
  ownerHasCapacity      Boolean   @default(false)
  projectStatement      String    @db.Text
  definitionOfDone      String    @db.Text
  month1Milestone       String    @db.Text
  month1Metric          String
  month1Target          String
  month2Milestone       String    @db.Text
  month2Metric          String
  month2Target          String
  month3Milestone       String    @db.Text
  month3Metric          String
  month3Target          String
  budgetConfirmed       Boolean   @default(false)
  spaceConfirmed        Boolean   @default(false)
  equipmentConfirmed    Boolean   @default(false)
  staffHoursConfirmed   Boolean   @default(false)
  topRisks              String    @db.Text
  contingencyPlan       String    @db.Text
  completedAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Stage4Data {
  id               String         @id @default(cuid())
  projectId        String         @unique
  project          Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  weeklyUpdates    WeeklyUpdate[]
  completionReport String?        @db.Text
  completedAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model WeeklyUpdate {
  id          String      @id @default(cuid())
  stage4Id    String
  stage4      Stage4Data  @relation(fields: [stage4Id], references: [id], onDelete: Cascade)
  weekOf      String
  status      TrackStatus
  notes       String?     @db.Text
  todoItem    String?
  metricValue String?
  issues      String?     @db.Text
  createdAt   DateTime    @default(now())
}

enum TrackStatus {
  ON_TRACK
  OFF_TRACK
}

model Stage5Data {
  id                     String    @id @default(cuid())
  projectId              String    @unique
  project                Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  definitionOfDoneReview String    @db.Text
  scorecardSummary       String    @db.Text
  financialImpact        String    @db.Text
  missionImpact          String    @db.Text
  operationalImpact      String    @db.Text
  lessonsLearned         String    @db.Text
  nextStepDecision       NextStep
  processDocumentation   String?   @db.Text
  completedAt            DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}

enum NextStep {
  RETIRE
  SUSTAIN
  EXPAND
  CARRY
  KILL
}

model CoreValue {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
}

model StrategicPlan {
  id             String            @id @default(cuid())
  mission        String            @db.Text @default("")
  tenYearTarget  String            @db.Text @default("")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  pillars        ThreeYearPillar[]
}

model ThreeYearPillar {
  id          String        @id @default(cuid())
  planId      String
  plan        StrategicPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  title       String
  description String        @db.Text @default("")
  goal        String        @db.Text @default("")
  order       Int
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  yearPlan  OneYearPlan?
}

model OneYearPlan {
  id        String          @id @default(cuid())
  pillarId  String          @unique
  pillar    ThreeYearPillar @relation(fields: [pillarId], references: [id], onDelete: Cascade)
  title     String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  goals     AnnualGoal[]
}

model AnnualGoal {
  id         String        @id @default(cuid())
  planId     String
  plan       OneYearPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  title      String        @db.Text
  order      Int
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  stage1s    Stage1Data[]
}

